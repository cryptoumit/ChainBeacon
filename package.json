{
  "name": "chainbeacon",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain intelligence for customer support teams.",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check README.md eslint.config.js .prettierrc.json package.json package-lock.json vite.config.ts tsconfig.json .github/workflows/ci.yml .github/workflows/build-automation.yml .github/scripts/package-extension.mjs src/domain/detection.ts src/domain/detection.test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
