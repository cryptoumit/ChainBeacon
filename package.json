{
  "name": "chainbeacon",
  "version": "0.1.4",
  "private": true,
  "description": "Blockchain intelligence for customer support teams.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @chainbeacon/web",
    "dev:extension": "npm run dev --workspace @chainbeacon/extension",
    "build": "npm run check && npm run build:web && npm run build:extensions",
    "build:web": "GITHUB_PAGES=true npm run build --workspace @chainbeacon/web",
    "build:chrome": "EXTENSION_TARGET=chrome npm run build --workspace @chainbeacon/extension",
    "build:firefox": "EXTENSION_TARGET=firefox npm run build --workspace @chainbeacon/extension",
    "build:extensions": "npm run build:chrome && npm run build:firefox",
    "version:bump": "node scripts/bump-version.mjs",
    "preview": "npm run preview --workspace @chainbeacon/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
