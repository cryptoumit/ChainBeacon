{
  "manifest_version": 3,
  "name": "ChainBeacon",
  "version": "1.0.0",
  "description": "Blockchain intelligence for customer support teams.",
  "host_permissions": [
    "https://blockstream.info/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChainBeacon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
